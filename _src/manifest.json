{
  "manifest_version": 3,
  "name": "CleanText v1.0.1 [BETA]",
  "version": "1.0.1",
  "description": "Detect AI-generated text and humanize it. Works 100% offline.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CleanText v1.0.1 [BETA]",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "commands": {
    "humanize-text": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Detect AI-generated text and humanize it. Works 100% offline."
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
